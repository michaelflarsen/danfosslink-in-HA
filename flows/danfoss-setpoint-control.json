        "name": "Forbered payload",
        "func": "// Ny setpoint temperatur fra HA input_number\nlet newTemp = parseFloat(msg.payload);\nif (isNaN(newTemp)) { return null; }\nmsg.payload = newTemp;\nreturn msg;",
